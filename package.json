{
  "name": "nexus-marketplace",
  "version": "1.0.0",
  "description": "NEXUS: a trend-tech dropshipping storefront prototype with a verified 64-product catalogue shipped worldwide, collection, product, compare, setup, checkout, account, order and guide pages, a works-with-your-setup checker and the Trend Scout.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "preview": "vite preview",
    "photos": "node scripts/embed-photos.mjs",
    "fragment": "node scripts/fragment.mjs",
    "publish:fragment": "npm run build && npm run fragment",
    "test:watch": "vitest",
    "research:merge": "node scripts/merge-research.mjs",
    "radar": "tsx radar/src/index.ts run",
    "radar:dry": "tsx radar/src/index.ts run --dry --skip-cj",
    "merge": "node scripts/merge-trends.mjs && node scripts/merge-listings.mjs",
    "listing": "tsx radar/src/listing-cli.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9"
  }
}
