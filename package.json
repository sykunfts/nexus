{
  "name": "nexus-marketplace",
  "version": "1.0.0",
  "description": "NEXUS: a trend-tech dropshipping storefront (64 verified products, worldwide shipping, every page working), the Trend Radar, a daily pipeline that matches rising tech trends to CJdropshipping stock, costs them to Australia and drafts listings, and a Cloudflare Worker back office that takes payment through Stripe and fulfils through CJ.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p office/tsconfig.json",
    "preview": "vite preview",
    "photos": "node scripts/embed-photos.mjs",
    "fragment": "node scripts/fragment.mjs",
    "publish:fragment": "npm run build && npm run fragment",
    "test:watch": "vitest",
    "research:merge": "node scripts/merge-research.mjs",
    "radar": "tsx radar/src/index.ts run",
    "radar:dry": "tsx radar/src/index.ts run --dry --skip-cj",
    "merge": "node scripts/merge-trends.mjs && node scripts/merge-listings.mjs",
    "listing": "tsx radar/src/listing-cli.ts",
    "office:merge": "node scripts/merge-office.mjs",
    "office:test": "vitest run office",
    "office:check": "wrangler deploy --dry-run --outdir .wrangler/dry --config office/wrangler.toml",
    "office:deploy": "wrangler deploy --config office/wrangler.toml"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "js-yaml": "^5.4.2",
    "jsdom": "^25.0.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9",
    "wrangler": "^3.99.0"
  }
}
